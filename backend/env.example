# Copy to `.env` and fill in real values. NEVER commit real credentials to this file.
#   cp env.example .env

# ─── Database (Supabase) ──────────────────────────────────────────────────────
# Both strings come from: Supabase Dashboard → Connect → ORMs → Prisma
# If your password contains special characters, percent-encode them (@ -> %40).
# Simpler: generate an alphanumeric-only password.

# Pooled — Transaction pooler, port 6543. Used by the app at runtime.
# `pgbouncer=true` is REQUIRED (disables prepared statements for transaction pooling).
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20"

# Direct — Session pooler, port 5432. Used ONLY by `prisma migrate` / `db push`.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET="replace-me-with-at-least-32-random-characters"
# Must be different from JWT_SECRET. Both need at least 32 characters.
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV="development"

# Comma-separated list of allowed origins.
CORS_ORIGIN="http://localhost:3000"

# Reverse-proxy hops in front of the API (0 locally; 2 on Render behind the Next.js proxy).
TRUST_PROXY=0

# Shared with the frontend (same value there). When set, the API only serves
# requests that come through the Next.js proxy. Required in production.
# Generate with: openssl rand -hex 32
# API_PROXY_SECRET=

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=600
# Failed login/register attempts allowed per window per IP.
AUTH_RATE_LIMIT_MAX=10

# ─── AI Coach (optional) ──────────────────────────────────────────────────────
# Without a key the app runs normally and the coach says it isn't configured.
# Use a project-scoped key with a monthly budget (platform.openai.com).
# OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-6-luna"
# none | low | medium | high
OPENAI_REASONING_EFFORT="low"
AI_MAX_OUTPUT_TOKENS=1500
# AI requests (all features) per user per day; the shared demo account; all users per UTC day.
AI_DAILY_LIMIT=20
AI_DEMO_DAILY_LIMIT=30
AI_GLOBAL_DAILY_LIMIT=500

# ─── Misc ─────────────────────────────────────────────────────────────────────
LOG_LEVEL="info"
BCRYPT_ROUNDS=12
