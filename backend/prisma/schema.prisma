generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (PgBouncer, port 6543) — used by the app at runtime
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) — used by `prisma migrate` / `db push`
  directUrl = env("DIRECT_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  username       String   @unique
  password       String
  firstName      String?
  lastName       String?
  avatar         String?
  timezone       String   @default("UTC")
  // Embedded in every token; incrementing it revokes all of the user's sessions.
  tokenVersion   Int      @default(0)
  // Opt-in: nothing is sent to the AI provider until the user turns this on.
  aiCoachEnabled Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  goals         Goal[]
  tasks         Task[]
  schedules     Schedule[]
  habits        Habit[]
  taskTags      TaskTag[]
  reflections   Reflection[]
  focusSessions FocusSession[]
  coachMessages CoachMessage[]
  aiUsage       AiUsage[]
  weeklyReviews WeeklyReview[]

  @@map("users")
}

model Goal {
  id                String     @id @default(cuid())
  title             String
  description       String?
  targetDate        DateTime?
  priority          Priority   @default(MEDIUM)
  status            GoalStatus @default(ACTIVE)
  progress          Int        @default(0)
  // Display colour (hex) and the time the user intends to invest; these used
  // to be JSON-encoded inside `description`, which now holds free text only.
  color             String     @default("#3B82F6")
  targetHoursWeekly Float      @default(10)
  targetHoursDaily  Float      @default(1.5)
  userId            String
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones    Milestone[]
  tasks         Task[]
  schedules     Schedule[]
  focusSessions FocusSession[]

  @@index([userId, status])
  @@map("goals")
}

model Milestone {
  id          String    @id @default(cuid())
  title       String
  description String?
  targetDate  DateTime?
  completed   Boolean   @default(false)
  goalId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("milestones")
}

model Task {
  id            String     @id @default(cuid())
  title         String
  description   String?
  priority      Priority   @default(MEDIUM)
  status        TaskStatus @default(PENDING)
  dueDate       DateTime?
  completedAt   DateTime?
  estimatedTime Int?
  actualTime    Int?
  userId        String
  goalId        String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal          Goal?          @relation(fields: [goalId], references: [id], onDelete: SetNull)
  tags          TaskTag[]
  subtasks      Subtask[]
  schedules     Schedule[]
  focusSessions FocusSession[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([goalId])
  @@map("tasks")
}

model TaskTag {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#3B82F6")
  userId    String
  taskId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([name, taskId])
  @@index([taskId])
  @@map("task_tags")
}

model Schedule {
  id              String            @id @default(cuid())
  title           String
  description     String?
  startTime       DateTime
  endTime         DateTime
  allDay          Boolean           @default(false)
  recurring       RecurringPattern?
  status          ScheduleStatus    @default(PENDING)
  notes           String?
  actualTimeSpent Int?
  goalId          String?
  taskId          String?
  userId          String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal          Goal?          @relation(fields: [goalId], references: [id], onDelete: SetNull)
  task          Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  focusSessions FocusSession[]

  @@index([userId, startTime])
  @@index([goalId])
  @@index([taskId])
  @@map("schedules")
}

model Habit {
  id          String         @id @default(cuid())
  name        String
  description String?
  frequency   HabitFrequency
  targetCount Int            @default(1)
  userId      String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions HabitCompletion[]

  @@index([userId])
  @@map("habits")
}

model HabitCompletion {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  count     Int      @default(1)
  notes     String?
  habitId   String
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@map("habit_completions")
}

model Subtask {
  id        String   @id @default(cuid())
  title     String
  completed Boolean  @default(false)
  position  Int      @default(0)
  taskId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, position])
  @@map("subtasks")
}

// One end-of-day review per user per calendar day (user's time zone).
model Reflection {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  performance Int?
  energy      Int?
  mood        Int?
  notes       String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("reflections")
}

// A focused work interval from the focus timer. Breaks are not recorded.
model FocusSession {
  id              String   @id @default(cuid())
  startedAt       DateTime
  endedAt         DateTime
  durationSeconds Int
  plannedSeconds  Int
  completed       Boolean
  userId          String
  goalId          String?
  taskId          String?
  // The planned time block this session was started from, if any. Its
  // focused time replaces the block's planned duration in "actual hours".
  scheduleId      String?
  createdAt       DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal     Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  task     Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  schedule Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([goalId])
  @@index([taskId])
  @@index([scheduleId])
  @@map("focus_sessions")
}

// One turn of the AI coach conversation (one conversation per user).
model CoachMessage {
  id          String    @id @default(cuid())
  role        CoachRole
  content     String
  // Actions the coach proposed with this reply (validated, ready to apply).
  suggestions Json?
  userId      String
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("coach_messages")
}

// One call to the AI provider, for daily caps and cost tracking. Rows outlive
// a deleted user (userId becomes null) so the global cap can't be reset.
model AiUsage {
  id           String   @id @default(cuid())
  userId       String?
  model        String
  // coach | weekly_review | week_plan | goal_breakdown
  feature      String   @default("coach")
  status       String // pending | ok | error | aborted
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  durationMs   Int?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("ai_usage")
}

// The AI's review of one week (Sunday to Saturday), kept so it's generated
// once rather than on every visit. Regenerating replaces it.
model WeeklyReview {
  id        String   @id @default(cuid())
  weekStart DateTime @db.Date
  content   Json
  model     String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@map("weekly_reviews")
}

enum CoachRole {
  USER
  ASSISTANT
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ScheduleStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
  RESCHEDULED
}

enum RecurringPattern {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum HabitFrequency {
  DAILY
  WEEKLY
  MONTHLY
}
