{
  "name": "growthtracker-backend",
  "version": "1.0.0",
  "description": "Backend API for GrowthTracker application",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:baseline": "prisma migrate resolve --applied 0_init",
    "db:studio": "prisma studio",
    "db:seed": "ts-node --transpile-only src/scripts/seed.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "keywords": [
    "productivity",
    "goals",
    "tracking",
    "api"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^11.11.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "openai": "^7.43.0",
    "prisma": "^6.19.3",
    "web-push": "^3.6.7",
    "winston": "^3.11.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.5",
    "@types/supertest": "^2.0.16",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
